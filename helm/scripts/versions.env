# Single place for the tool/chart versions the helm/ scripts install. Keep in sync with docs/VERSIONS.md.
MINIKUBE_VERSION=1.39.0
KUBERNETES_VERSION=v1.37.0
HELM_MIN_MAJOR=4
SPARK_OPERATOR_VERSION=2.5.2
SPARK_OPERATOR_REPO=https://kubeflow.github.io/spark-operator
ENVOY_GATEWAY_VERSION=v1.9.2
DRA_DRIVER_VERSION=0.5.0
HEADLAMP_VERSION=0.45.0                      # chart version == app version; image ghcr.io/headlamp-k8s/headlamp:v0.45.0
HEADLAMP_REPO=https://kubernetes-sigs.github.io/headlamp/
HEADLAMP_PLUGINCTL_VERSION=0.1.1             # @headlamp-k8s/pluginctl run by the chart's plugin-manager sidecar
HEADLAMP_KUBEFLOW_PLUGIN_VERSION=0.2.0-alpha # Artifact Hub package headlamp-plugins/headlamp_kubeflow
